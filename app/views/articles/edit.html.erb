<h1>Create your new article</h1>

<%= form_with(model: @article, local: true, data: {turbo: false}) do |f| %>

    <p>
        <%= f.label :title %> <br>
        
        <%= f.text_field :title %>
    </p>

        <%= f.label :description %> <br>
        
        <%= f.text_area :description %>
    </p>

    <%= f.submit %>


<%end%>

<%= link_to 'Back to articles', articles_path %>